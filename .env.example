# SQLite-Datei (bei Docker ist /data/timekeeper.db empfohlen)
DATABASE_URL=sqlite:///./timekeeper.db
TIMEZONE=Europe/Berlin
# Schutz optional aktivieren, bevor die Anwendung öffentlich erreichbar ist.
AUTH_ENABLED=false
AUTH_USERNAME=admin
# "change-me" wird bei aktiviertem Schutz bewusst abgelehnt.
AUTH_PASSWORD=hier-ein-starkes-passwort-setzen
